# Server-only configuration. Shared live data works without a data token.
PORT=4317
STREETLI_CASES_MODE=live

# Server-side sponsor integrations.
YDC_API_KEY=
PARASAIL_API_KEY=
PARASAIL_BASE_URL=https://api.parasail.io/v1
PARASAIL_MODEL=
ONE_SECRET=
# Optional executable override; normal setup finds the local venv on Windows/macOS/Linux.
GHOST_LINKS_PYTHON=

# Shared public projection; leave the token empty. Set MODE=fixture for offline examples.
# For local private bridge development: http://127.0.0.1:4318/api/cases
STREETLI_CASES_URL=https://us-central1-streetli.cloudfunctions.net/streetliGhostLinksCases
STREETLI_CASES_TOKEN=

# One actions (run `npm run one:setup` after connecting Discord, Gmail, Google Sheets, Twilio in One).
# Discord channel for review tickets (#loft-incident at the event) and the events/action-list spreadsheet
# (tabs named Events and Actions).
DISCORD_CHANNEL_ID=
GHOST_LINKS_SHEET_ID=
# Twilio via One for "Text me this list": your Account SID (AC...) and a Twilio number
# in E.164 (+1...) or a Messaging Service SID (MG...). Not secrets; the One key stays in ONE_SECRET.
TWILIO_ACCOUNT_SID=
TWILIO_FROM=
# Optional Secret Manager volume path; defaults to ignored data/one-actions.json.
ONE_ACTIONS_FILE=

# Hosted research only: backend service credential and owner/team browser access code.
# Cloudflare uses MAINTAINER_TOKEN; the owner keeps its copy under this local name.
RESEARCH_BACKEND_TOKEN=
GHOST_LINKS_MAINTAINER_TOKEN=
